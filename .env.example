# Optional — bootstraps the first admin user on startup if no admin exists yet.
# Leave both blank to skip (app still boots; you'll need to create an admin manually).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Required — JWT signing key (base64-encoded 256-bit key)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Required — Gmail address used to send system emails
EMAIL_ADDRESS=

# Required — Gmail App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# Required — PostgreSQL connection (used by dev/prod profiles)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
