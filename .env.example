# Every variable the backend reads. Copy to .env or set them in your run configuration.
# Locally (profile `local`) only JWT_SECRET is needed: the rest have defaults for the Docker
# Compose containers. See CONFIG.md for what to set on Render dev and prod.
# Example values below are safe placeholders, not real credentials.

# Profile: local | dev | prod
SPRING_PROFILES_ACTIVE=local

# Required everywhere. JWT signing key, base64-encoded 256-bit.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Database. Optional locally (defaults match local/docker-compose.yaml), required on dev and prod.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=booking_system
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=

# Email. Optional locally (Mailpit, view mail at http://localhost:8025).
# Required on dev and prod with no defaults: the app will not start if any of the first five is missing.
EMAIL_ADDRESS=bookings@example.com
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TRANSPORT_STRATEGY=SMTPS
# Blank means the value of EMAIL_ADDRESS. Resend needs "resend".
EMAIL_SMTP_USERNAME=resend
# Optional Reply-To on every email.
EMAIL_REPLY_TO=

# Comma-separated frontend origins allowed by CORS. Entries may contain * wildcards; a bare * is
# rejected. Defaults to http://localhost:3000 on local and dev; required on prod.
ALLOWED_ORIGINS=http://localhost:3000

# URL the password-reset email links to; the token is appended as ?token=...
# Defaults to the local UI on local; required on dev and prod.
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Optional. Creates the first admin on startup if none exists. Leave blank to skip.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional. JVM memory options on Render, read by the JVM itself.
# JAVA_TOOL_OPTIONS=-Xmx384m

# Not read by the code yet (added with error tracking). Listed so Render can be prepared.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=dev
