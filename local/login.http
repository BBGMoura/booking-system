### Login as the bootstrapped admin (local profile)
# Fill in the email/password matching your local admin.bootstrap.* values
# in application-local.yaml (git-ignored) — don't commit real credentials here.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "<your local ADMIN_BOOTSTRAP_EMAIL>",
  "password": "<your local ADMIN_BOOTSTRAP_PASSWORD>"
}
